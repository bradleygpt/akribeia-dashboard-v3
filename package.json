{
  "name": "akribeia-platform-v3",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build --workspace @akribeia/dashboard && npm run test:ci",
    "test:ci": "vitest run && npm run test --workspace @akribeia/dashboard",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "preview:generate": "npm run typecheck && node packages/pipeline/dist/cli.js",
    "evidence:generate": "npm run typecheck && node packages/evidence/dist/cli.js",
    "governance:generate": "npm run typecheck && node packages/evidence/dist/governance-cli.js",
    "quality:generate": "npm run typecheck && node packages/evidence/dist/quality-cli.js",
    "master:generate": "npm run typecheck && node packages/evidence/dist/security-master-cli.js",
    "maturity:generate": "npm run typecheck && node packages/evidence/dist/maturity-cli.js",
    "historical-readiness:generate": "npm run typecheck && node packages/evidence/dist/historical-readiness-cli.js",
    "universe-membership:generate": "npm run typecheck && node packages/evidence/dist/universe-membership-cli.js",
    "corporate-actions:generate": "npm run typecheck && node packages/evidence/dist/corporate-action-readiness-cli.js",
    "exit-disposition:generate": "npm run typecheck && node packages/evidence/dist/exit-disposition-readiness-cli.js",
    "execution-costs:generate": "npm run typecheck && node packages/evidence/dist/execution-cost-readiness-cli.js",
    "sec-identity:fetch": "npm run typecheck && node packages/evidence/dist/sec-identity-source-cli.js",
    "registrants:generate": "npm run typecheck && node packages/evidence/dist/sec-registrants-cli.js",
    "filing-sources:fetch": "npm run typecheck && node packages/evidence/dist/sec-submissions-source-cli.js",
    "filing-availability:generate": "npm run typecheck && node packages/evidence/dist/filing-availability-cli.js",
    "validate": "npm run typecheck && npm run lint && npm run build && npm run test:ci",
    "ci": "npm run format:check && npm run validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=22"
  }
}
